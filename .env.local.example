# ---------------------------------------------------------------------------
# IGC CTF - THE INSIDER THREAT
#
# Copy this file to .env.local and replace every REPLACE_ME_* placeholder with
# the real answer for your event. This example file must never contain a real
# answer: it is tracked by git.
# ---------------------------------------------------------------------------

# Stage 1 - lockscreen. Founding year of IGC.
CTF_LOGIN=2018

# Stage 3 - password obtained by decrypting the encrypted archive.
CTF_CLASSIFIED=REPLACE_ME_CLASSIFIED_PASSWORD

# Stage 4 - data given by the telecom operator.
CTF_CONFIDENTIAL=REPLACE_ME_OPERATOR_PASSWORD

# Stage 5 - vault fields. Date as DD/MM, time as HH:MM.
CTF_DATE=15/10
CTF_TIME=20:04
# Location accepts several spellings separated by | (variants are normalised).
CTF_LOCATION=REPLACE_ME_LOCATION_A|REPLACE_ME_LOCATION_B

# Stage 7 - name of the member shown in evidence_02, compared with the
# department photo in evidence_01. Comma-separated accepted spellings:
# first name, full name, etc. NEVER put the real name in this tracked example.
CTF_MEMBER_NAME=REPLACE_ME_FIRST_NAME,REPLACE_ME_FULL_NAME

# Legacy fallback for CTF_PROOF_SECRET only (no longer used as an answer).
CTF_TECH_ASSISTANT=REPLACE_ME_TECHNICAL_ASSISTANT

# Stage 8 - final code handed out by the club president.
# Only accepted after final_photo: the client must send the server-signed proof.
CTF_FINAL=REPLACE_ME_FINAL_CODE

# Server-only HMAC key for short-lived unlock proofs (recommended: 32+ random bytes).
# If omitted, CTF_TECH_ASSISTANT is used. Never expose this value to the client.
CTF_PROOF_SECRET=REPLACE_ME_LONG_RANDOM_SECRET

# Set to 1 only behind a trusted reverse proxy, so x-forwarded-for / x-real-ip
# are used for rate limiting. Otherwise the socket IP is used (30 attempts/min).
TRUST_PROXY=0
